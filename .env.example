# Digital Wallet and Payment Gateway Simulator - Environment Configuration Example
# Copy this file to .env and fill in real values. NEVER commit .env to source control!

# Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wallet_gateway_db
DB_USER=wallet_user
DB_PASSWORD=wallet_secure_password_replace_me

# JWT Authentication
JWT_SECRET=dwpg_super_secret_jwt_hmac_sha256_key_min_32_bytes_long_entropy_string!
JWT_EXPIRATION_MS=86400000

# Jira Integration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# SonarQube Configuration
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonarqube_token_here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080

        <mxCell id="title_banner" value="DIGITAL WALLET &amp; PAYMENT GATEWAY SIMULATOR | ENTITY-RELATIONSHIP DIAGRAM (3RD NORMAL FORM RELATIONAL SCHEMA)" style="shape=rect;fillColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1280" height="40" as="geometry" /></mxCell>
        <mxCell id="t_user" value="users&#xa;───────────────&#xa;PK id : BIGINT&#xa;   username : VARCHAR(50) [UQ]&#xa;   email : VARCHAR(100) [UQ]&#xa;   password_hash : VARCHAR(100)&#xa;   role : VARCHAR(20)&#xa;   created_at : TIMESTAMP" style="rounded=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontStyle=1;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="260" height="140" as="geometry" /></mxCell>

  <diagram id="DWPG-09_architecture" name="System Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_banner" value="DIGITAL WALLET &amp; PAYMENT GATEWAY SIMULATOR | SYSTEM ARCHITECTURE (5-TIER SECURE PATTERN)" style="shape=rect;fillColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1280" height="40" as="geometry" /></mxCell>
        <mxCell id="l1" value="TIER 1: PRESENTATION TIER&#xa;React 18 Single Page Application | Vite Bundler | TailwindCSS&#xa;Axios HTTP Interceptors | Bearer Token Session Management | Client-Side Input Sanitization" style="rounded=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="1200" height="70" as="geometry" /></mxCell>
        <mxCell id="l2" value="TIER 2: API GATEWAY &amp; SECURITY PERIMETER TIER&#xa;Spring Security 6.x | DelegatingFilterProxy | OncePerRequestFilter (JwtAuthenticationFilter)&#xa;IdempotencyValidationInterceptor | Rate Limiter | Global CORS Configuration" style="rounded=1;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="1200" height="70" as="geometry" /></mxCell>
        <mxCell id="l3" value="TIER 3: CORE APPLICATION SERVICE TIER&#xa;AuthService (BCrypt 12) | WalletService (Pessimistic Concurrency) | PaymentService (Atomic Transfer)&#xa;MerchantService (API Key Hash) | RefundService (State FSM) | AuditService (Forensics)" style="rounded=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="1200" height="80" as="geometry" /></mxCell>
        <mxCell id="l4" value="TIER 4: PERSISTENCE &amp; TRANSACTIONAL INTEGRITY TIER&#xa;Spring Data JPA | Hibernate ORM | @Transactional(isolation = Isolation.READ_COMMITTED)&#xa;@Lock(LockModeType.PESSIMISTIC_WRITE) | HikariCP Managed Connection Pool" style="rounded=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="360" width="1200" height="70" as="geometry" /></mxCell>
        <mxCell id="l5" value="TIER 5: SECURE DATA STORAGE TIER&#xa;MariaDB 11.4 Relational Engine / In-Memory H2 | ACID Guarantees&#xa;CHECK Constraints (balance &gt;= 0) | SHA-256 Idempotency Cache | Immutable Audit Table" style="rounded=1;shape=cylinder;fillColor=#FEF2F2;strokeColor=#DC2626;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="1200" height="70" as="geometry" /></mxCell>
        <mxCell id="la1" value="HTTPS / JSON REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E3A8A;strokeWidth=2;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="la2" value="Authenticated Request Context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E3A8A;strokeWidth=2;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="la3" value="Transactional Method Invocations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E3A8A;strokeWidth=2;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="la4" value="SQL via JDBC / SELECT FOR UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E3A8A;strokeWidth=2;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry" /></mxCell>

